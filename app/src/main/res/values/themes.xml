<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        No statusBarColor, navigationBarColor or windowLayoutInDisplayCutoutMode
        here. All three are deprecated from Android 15 and Play flags them, and
        enableEdgeToEdge() in MainActivity already makes the bars transparent and
        draws around cutouts - the theme was doing the deprecated version of a
        job the API does properly.
    -->
    <style name="Theme.Morpho" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Morpho.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_wings</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Morpho</item>
    </style>
</resources>
